<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardView"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:layout_marginHorizontal="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Prominent Article Banner Image (Inshorts Style) -->
        <ImageView
            android:id="@+id/newsImage"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:scaleType="centerCrop"
            android:adjustViewBounds="true"
            android:contentDescription="Article Image"
            android:visibility="gone" />

        <!-- Source & Actions Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp">

            <TextView
                android:id="@+id/sourceTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Global News"
                android:textStyle="bold"
                android:textSize="13sp"
                android:textColor="?android:attr/textColorPrimary" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/audioButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="4dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_volume_up"
                android:contentDescription="Listen to Audio"
                android:clickable="true"
                android:focusable="true"
                app:tint="?android:attr/textColorPrimary"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <ImageView
                android:id="@+id/bookmarkIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="4dp"
                android:layout_marginEnd="8dp"
                android:src="@drawable/ic_bookmark_outline"
                android:contentDescription="Bookmark Article"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <ImageView
                android:id="@+id/shareIcon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="4dp"
                android:src="@drawable/ic_share"
                android:contentDescription="Share Article"
                android:clickable="true"
                android:focusable="true"
                app:tint="?android:attr/textColorPrimary"
                android:background="?attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <!-- Article Headline -->
        <TextView
            android:id="@+id/newsTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Headline text goes here..."
            android:textSize="18sp"
            android:textStyle="bold"
            android:lineSpacingExtra="3dp"
            android:paddingHorizontal="16dp"
            android:paddingTop="10dp"
            android:textColor="?android:attr/textColorPrimary" />

        <!-- Article Description / Story Summary -->
        <TextView
            android:id="@+id/newsDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Detailed description of the news story..."
            android:textSize="14sp"
            android:lineSpacingExtra="2dp"
            android:paddingHorizontal="16dp"
            android:paddingTop="8dp"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- Metadata Footer (Time Ago | Author | Source) -->
        <TextView
            android:id="@+id/newsFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="few hours ago | Author Name"
            android:textSize="12sp"
            android:textColor="#888888"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="4dp" />

        <!-- Ask this Story AI Button -->
        <LinearLayout
            android:id="@+id/btnAskStory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_ask_story_button"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UNCOVER STORY FACTS"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Read More Button -->
        <TextView
            android:id="@+id/readMore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to read full story →"
            android:textColor="@color/blue"
            android:textStyle="bold"
            android:textSize="13sp"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp"
            android:paddingTop="4dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
