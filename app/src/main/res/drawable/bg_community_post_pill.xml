<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#E65100"
                android:endColor="#F57C00"
                android:angle="45" />
            <corners android:radius="14dp" />
            <padding
                android:left="10dp"
                android:top="4dp"
                android:right="10dp"
                android:bottom="4dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#FF6F00"
                android:endColor="#FFA000"
                android:angle="45" />
            <corners android:radius="14dp" />
            <padding
                android:left="10dp"
                android:top="4dp"
                android:right="10dp"
                android:bottom="4dp" />
        </shape>
    </item>
</selector>
