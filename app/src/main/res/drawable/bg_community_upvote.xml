<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#260984E3" />
            <stroke android:width="1dp" android:color="#0984E3" />
            <corners android:radius="14dp" />
            <padding android:left="10dp" android:top="4dp" android:right="10dp" android:bottom="4dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#120984E3" />
            <stroke android:width="1dp" android:color="#200984E3" />
            <corners android:radius="14dp" />
            <padding android:left="10dp" android:top="4dp" android:right="10dp" android:bottom="4dp" />
        </shape>
    </item>
</selector>
